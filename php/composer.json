            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "textsimilarity",
        "text similarity api",
        "compare two texts",
        "string similarity score",
        "text match percentage",
        "check text similarity"
    ],
    "homepage": "https://apiverve.com/marketplace/textsimilarity?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/textsimilarity",
        "source": "https://github.com/apiverve/textsimilarity-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Textsimilarity\\": "src/"
        }
    },
